# Hermes Chat — Backend Environment Variables
# Copy this file to server/.env and fill in real values.

# Server port
PORT=3001

# Default Hermes agent address (hostname or IP)
HERMES_DEFAULT_HOST=localhost

# Default Hermes agent WebSocket port
HERMES_DEFAULT_PORT=8080

# Path to SQLite database file
DB_PATH=./data/hermes-chat.db

# Path to SSH private key for tunneling
SSH_KEY_PATH=./keys/id_rsa
